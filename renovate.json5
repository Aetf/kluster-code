{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'group:pulumi',
  ],
  major: {
    dependencyDashboardApproval: true,
  },
  patch: {
    enabled: false,
  },
  // Merging is not renovate's job any more: .github/workflows/noop-automerge.yml
  // merges any PR that leaves `src/` and `Pulumi.*` untouched once it has proven
  // the preview is empty -- which covers every update renovate used to automerge
  // here, and covers them with the zero-diff proof renovate cannot do. Two
  // mechanisms racing would also mean whichever wins picks the merge strategy,
  // and renovate's squash rewrites the committer to noreply@github.com.
  lockFileMaintenance: {
    enabled: true,
  },
  ignorePaths: [
    'src/crds/**',
  ],
  packageRules: [
    {
      // @pulumi/pulumi 3.253.0 silently dropped 238 resources from
      // `pulumi preview` with no diagnostics due to incompatibility with the
      // pinned @pulumi/kubernetes 3.30 / kubernetesx stack (see commit
      // c93d8d78). Require manual review for any bump until that's verified.
      matchPackageNames: [
        '@pulumi/pulumi',
        '@pulumi/kubernetes',
        '@pulumi/kubernetesx',
      ],
      dependencyDashboardApproval: true,
    },
    {
      // bitnami moved their charts to an OCI-only registry. 20.3.0 is the last
      // redis version published as an https .tgz under charts.bitnami.com;
      // every version from 20.13.4 up resolves to
      // oci://registry-1.docker.io/bitnamicharts/redis. We render charts with
      // helm.v3.Chart, which cannot pull OCI refs and dies with
      // `invalid_reference: invalid tag`, taking down the whole preview rather
      // than just that chart (see PR #139). Keep these frozen until #100 moves
      // us to helm.v3.Release. Matched on the registry instead of on `redis` so
      // any future chart from this host is covered too; note sealed-secrets
      // lives on bitnami.github.io and is *not* affected.
      matchDatasources: [
        'helm',
      ],
      matchRegistryUrls: [
        'https://charts.bitnami.com/bitnami',
      ],
      enabled: false,
    },
    {
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'digest',
      ],
      groupName: 'dependencies with non-major changes',
      groupSlug: 'deps-non-major',
    },
    {
      matchDepTypes: [
        'helm',
        'container',
      ],
      semanticCommitType: 'fix',
      semanticCommitScope: 'apps',
    },
    {
      matchDepTypes: [
        'helm',
        'container',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'digest',
      ],
      // These live in `Pulumi.dev.yaml` and always produce a real Kubernetes
      // diff, so noop-automerge.yml classifies them as needing a human and
      // never touches them. Application updates get eyeballed.
      groupName: 'applications with non-major changes',
      groupSlug: 'apps-non-major',
    },
  ],
  customManagers: [
    {
      // Version pins in docker/*.conf, marked by a `# renovate:` hint comment
      // on the preceding line. Only emailproxy.conf carries hints; the cnpg
      // confs are unmarked on purpose -- those images are built manually with
      // `just docker-*` (heavy builds, composite tags), while marked pins are
      // rebuilt and published automatically by images.yml after merge.
      customType: 'regex',
      managerFilePatterns: [
        '/^docker/.+\\.conf$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\n[A-Z_]+=(?<currentValue>[\\w.-]+)',
      ],
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Pulumi\\..+\\.ya?ml$/',
      ],
      matchStrings: [
        'chart:(?<depName>[\\w.-]+):\\s*(?<registryUrl>[\\w.:/-]+):(?<currentValue>[\\w.-]+)',
      ],
      datasourceTemplate: 'helm',
      versioningTemplate: 'helm',
      depTypeTemplate: 'helm',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Pulumi\\..+\\.ya?ml$/',
      ],
      matchStrings: [
        'image:(?<depName>[\\w.-]+):\\s*(?<packageName>[\\w./-]+):(?<currentValue>[\\w.-]+)',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
      depTypeTemplate: 'container',
    },
  ],
}

; email-oauth2-proxy config. This plaintext file rides along as the sealed
; secret's `template.data`: the sealed-secrets controller renders it as a
; Go/sprig template with the decrypted `encryptedData` as context, splicing
; in the account address and OAuth client id/secret.
;
; Clients (HA's imap integration) connect to the LAN LoadBalancer on 1993
; over TLS (HA's imap integration is IMAP4_SSL-only, plaintext IMAP cannot
; work); the certificate is a cluster BackendCertificate from the private
; CA, so clients either trust that CA or disable verification. Upstream the
; proxy speaks IMAPS+XOAUTH2 towards Gmail.

[IMAP-1993]
server_address = imap.gmail.com
server_port = 993
local_certificate_path = /tls/tls.crt
local_key_path = /tls/tls.key

[{{ index . "account" }}]
permission_url = https://accounts.google.com/o/oauth2/auth
token_url = https://oauth2.googleapis.com/token
oauth2_scope = https://mail.google.com/
redirect_uri = http://localhost:8080
client_id = {{ index . "client_id" }}
client_secret = {{ index . "client_secret" }}

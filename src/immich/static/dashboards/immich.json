{
  "uid": "immich",
  "title": "Immich",
  "description": "Immich job throughput and resource usage. Job counters come from the microservices worker's telemetry (IMMICH_TELEMETRY_INCLUDE=all): one metric name per job type, no labels, so the job name is pulled out of __name__ with label_replace. Counters reset when the server restarts, hence rate()/increase() everywhere. immich does not expose queue backlog depth at all -- 'Running by queue' plus the processing rate is as close as it gets.",
  "tags": [
    "immich",
    "jobs"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Data source",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(kube_pod_info{namespace=\"immich\"}, pod)",
        "hide": 0,
        "includeAll": true,
        "label": "Pod",
        "multi": true,
        "name": "pod",
        "options": [],
        "query": {
          "query": "label_values(kube_pod_info{namespace=\"immich\"}, pod)",
          "refId": "pod"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Jobs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "description": "Per-job counters from the microservices worker (port 8082). immich exposes one metric name per job with no labels, hence the __name__ regexes."
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Processed",
      "description": "Jobs finished successfully over the dashboard's time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase(label_replace({__name__=~\"immich_jobs_(.+)_success_total\"}, \"immich_job\", \"$1\", \"__name__\", \"immich_jobs_(.+)_success_total\")[$__range:]))",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Skipped",
      "description": "Jobs that ran and decided there was nothing to do -- normal for a re-queued asset.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase(label_replace({__name__=~\"immich_jobs_(.+)_skipped_total\"}, \"immich_job\", \"$1\", \"__name__\", \"immich_jobs_(.+)_skipped_total\")[$__range:]))",
          "range": false,
          "instant": true,
          "refId": "B"
        }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Failed",
      "description": "Jobs that threw. Anything above zero is worth looking at in the server log.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase(label_replace({__name__=~\"immich_jobs_(.+)_failed_total\"}, \"immich_job\", \"$1\", \"__name__\", \"immich_jobs_(.+)_failed_total\")[$__range:]))",
          "range": false,
          "instant": true,
          "refId": "C"
        }
      ]
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Running now",
      "description": "Jobs currently being worked on, summed over all queues. This is the number the admin UI shows; here it has history.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum({__name__=~\"immich_queues_.+_active\"})",
          "range": false,
          "instant": true,
          "refId": "D"
        }
      ]
    },
    {
      "type": "stat",
      "id": 6,
      "title": "Queue runs",
      "description": "How many times a queue was kicked off over the range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase(label_replace({__name__=~\"immich_queues_(.+)_started_total\"}, \"queue\", \"$1\", \"__name__\", \"immich_queues_(.+)_started_total\")[$__range:]))",
          "range": false,
          "instant": true,
          "refId": "E"
        }
      ]
    },
    {
      "type": "stat",
      "id": 7,
      "title": "Failure rate",
      "description": "Failed over failed+succeeded across the range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase(label_replace({__name__=~\"immich_jobs_(.+)_failed_total\"}, \"immich_job\", \"$1\", \"__name__\", \"immich_jobs_(.+)_failed_total\")[$__range:])) / clamp_min(sum(increase(label_replace({__name__=~\"immich_jobs_(.+_(?:success|failed))_total\"}, \"immich_job\", \"$1\", \"__name__\", \"immich_jobs_(.+_(?:success|failed))_total\")[$__range:])), 1)",
          "range": false,
          "instant": true,
          "refId": "F"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Processing rate by job",
      "description": "Successful job completions per second. Stacked, so the top of the area is total throughput.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 0,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (immich_job) (rate(label_replace({__name__=~\"immich_jobs_(.+)_success_total\"}, \"immich_job\", \"$1\", \"__name__\", \"immich_jobs_(.+)_success_total\")[$__rate_interval:]))",
          "range": true,
          "instant": false,
          "refId": "G",
          "legendFormat": "{{immich_job}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Running by queue",
      "description": "Jobs in flight per queue. A flat plateau at the concurrency limit means the queue is saturated; immich does not expose the waiting backlog itself.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "label_replace({__name__=~\"immich_queues_(.+)_active\"}, \"queue\", \"$1\", \"__name__\", \"immich_queues_(.+)_active\")",
          "range": true,
          "instant": false,
          "refId": "H",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "type": "barchart",
      "id": 10,
      "title": "Jobs processed over the range",
      "description": "Total per job over the dashboard's time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "axisPlacement": "auto",
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "stacking": "none",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (immich_job) (increase(label_replace({__name__=~\"immich_jobs_(.+)_success_total\"}, \"immich_job\", \"$1\", \"__name__\", \"immich_jobs_(.+)_success_total\")[$__range:]))",
          "range": false,
          "instant": true,
          "refId": "I",
          "legendFormat": "{{immich_job}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Failures and skips",
      "description": "Failures are the ones to chase; skips are usually a re-queued asset that already had its work done.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (immich_job) (rate(label_replace({__name__=~\"immich_jobs_(.+)_failed_total\"}, \"immich_job\", \"$1\", \"__name__\", \"immich_jobs_(.+)_failed_total\")[$__rate_interval:]))",
          "range": true,
          "instant": false,
          "refId": "J",
          "legendFormat": "failed: {{immich_job}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (immich_job) (rate(label_replace({__name__=~\"immich_jobs_(.+)_skipped_total\"}, \"immich_job\", \"$1\", \"__name__\", \"immich_jobs_(.+)_skipped_total\")[$__rate_interval:]))",
          "range": true,
          "instant": false,
          "refId": "K",
          "legendFormat": "skipped: {{immich_job}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 12,
      "title": "Resources",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": [],
      "description": "Container-level usage from cAdvisor and the limits from kube-state-metrics. Covers server, machine-learning, redis and the database pods."
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "CPU",
      "description": "Cores used per pod, with the limit for reference. immich-server's limit is an anti-runaway backstop, not a budget -- sustained running at it means the job queue is CPU bound.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "color": {
            "mode": "palette-classic"
          },
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"immich\", container!=\"\", pod=~\"$pod\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "refId": "L",
          "legendFormat": "{{pod}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (pod) (kube_pod_container_resource_limits{namespace=\"immich\", resource=\"cpu\", pod=~\"$pod\"})",
          "range": true,
          "instant": false,
          "refId": "M",
          "legendFormat": "limit: {{pod}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 14,
      "title": "Memory (working set)",
      "description": "Working set is what the OOM killer looks at. immich-server has been OOMKilled here before when media jobs ran at full concurrency.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "color": {
            "mode": "palette-classic"
          },
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"immich\", container!=\"\", pod=~\"$pod\"})",
          "range": true,
          "instant": false,
          "refId": "N",
          "legendFormat": "{{pod}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (pod) (kube_pod_container_resource_limits{namespace=\"immich\", resource=\"memory\", pod=~\"$pod\"})",
          "range": true,
          "instant": false,
          "refId": "O",
          "legendFormat": "limit: {{pod}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 15,
      "title": "Network",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "color": {
            "mode": "palette-classic"
          },
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
